# Copy these as variables when creating a GitLab Build > Pipeline schedule.
# This file is a repository-owned input template, not a native GitLab schedule object.
STILL_MONITOR_MAX_REQUESTS=3
STILL_MONITOR_TIMEOUT_SECONDS=5
STILL_RUN_SMOKE=true
STILL_RUN_DUO_REPAIR=false
STILL_RUN_GOVERN=false
STILL_RUN_DEPLOY=false
